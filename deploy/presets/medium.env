# Size preset for a 16 GB machine (tech doc section 5); also what Compose uses when no preset is given.
# Use after images.env: docker compose --env-file deploy/images.env --env-file deploy/presets/medium.env ...
# Kafka + Postgres limits add up to 1 GB; keep FLAKEHUNTER_INFRA_MEMORY (orchestrator) at least that.
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
KAFKA_MEM_LIMIT=768m
POSTGRES_SHARED_BUFFERS=128MB
POSTGRES_MEM_LIMIT=256m
TEST_RESULTS_RETENTION_DAYS=3
EVENTS_RETENTION_DAYS=14

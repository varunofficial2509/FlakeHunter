# Size preset for a 32 GB machine (tech doc section 5). Startup settings: restart Compose after changing.
# Use after images.env: docker compose --env-file deploy/images.env --env-file deploy/presets/large.env ...
# Kafka + Postgres limits add up to 1.5 GB: start the orchestrator with FLAKEHUNTER_INFRA_MEMORY=1536MB.
KAFKA_HEAP_OPTS=-Xms768m -Xmx768m
KAFKA_MEM_LIMIT=1024m
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_MEM_LIMIT=512m
TEST_RESULTS_RETENTION_DAYS=7
EVENTS_RETENTION_DAYS=30

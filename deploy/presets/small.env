# Size preset for an 8 GB machine (tech doc section 5). Startup settings: restart Compose after changing.
# Use after images.env: docker compose --env-file deploy/images.env --env-file deploy/presets/small.env ...
# Kafka + Postgres limits add up to 768 MB; keep FLAKEHUNTER_INFRA_MEMORY (orchestrator) at least that.
KAFKA_HEAP_OPTS=-Xms256m -Xmx256m
KAFKA_MEM_LIMIT=512m
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_MEM_LIMIT=256m
TEST_RESULTS_RETENTION_DAYS=1
EVENTS_RETENTION_DAYS=7

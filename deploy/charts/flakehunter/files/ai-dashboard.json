{
  "uid": "flakehunter-ai",
  "title": "FlakeHunter AI",
  "tags": ["flakehunter"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 41,
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "LLM usage",
      "description": "Model calls and tokens in the time range (agents.llm_calls, the same rows the token budgets count).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) AS calls, coalesce(sum(tokens_in), 0) AS \"tokens in\", coalesce(sum(tokens_out), 0) AS \"tokens out\"\nFROM agents.llm_calls WHERE $__timeFilter(created_at)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Tokens per finding",
      "description": "Average over findings that used the model in the time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(avg(tokens)) AS tokens FROM (\n  SELECT sum(tokens_in + tokens_out) AS tokens FROM agents.llm_calls\n  WHERE $__timeFilter(created_at) GROUP BY finding_id) per_finding"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fixes verified",
      "description": "Agent sessions that ended FIX_VERIFIED, of all that ended.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'FIX_VERIFIED') AS verified, count(*) FILTER (WHERE status IS NOT NULL) AS ended\nFROM results.diagnoses WHERE $__timeFilter(updated_at)"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens per hour by model",
      "description": "Input plus output tokens.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, 1h), model AS metric, sum(tokens_in + tokens_out) AS tokens\nFROM agents.llm_calls WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Tokens by agent",
      "description": "Which agent spends the budget.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT agent, sum(tokens_in) AS \"in\", sum(tokens_out) AS \"out\" FROM agents.llm_calls\nWHERE $__timeFilter(created_at) GROUP BY agent ORDER BY sum(tokens_in + tokens_out) DESC"
        }
      ],
      "options": {
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xTickLabelRotation": 0
      }
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Session outcomes",
      "description": "How agent sessions ended; RUNNING means still working.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT coalesce(status, 'RUNNING') AS outcome, count(*) AS sessions FROM results.diagnoses\nWHERE $__timeFilter(updated_at) GROUP BY 1"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": true,
          "calcs": [],
          "fields": ""
        },
        "legend": {
          "displayMode": "list",
          "placement": "right"
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Model latency",
      "description": "Per model, milliseconds per call.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT model, count(*) AS calls,\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS p50,\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS p95\nFROM agents.llm_calls WHERE $__timeFilter(created_at) GROUP BY model"
        }
      ]
    }
  ]
}

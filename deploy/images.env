# Pinned container images, shared by deploy/compose and the Helm values files.
# See docs/adr/0001-pin-tool-versions.md. Bump a tag here, never inline in a chart.

# Runtimes / base images
JDK_IMAGE=eclipse-temurin:21.0.12.1_1-jdk
JRE_IMAGE=eclipse-temurin:21.0.12.1_1-jre
# Runner bases, one per target JDK (ADR 0003); runner/images/build.sh builds flakehunter/runner:jdkN on them.
MAVEN_JDK8_IMAGE=maven:3.9.16-eclipse-temurin-8
MAVEN_JDK11_IMAGE=maven:3.9.16-eclipse-temurin-11
MAVEN_JDK17_IMAGE=maven:3.9.16-eclipse-temurin-17
MAVEN_JDK21_IMAGE=maven:3.9.16-eclipse-temurin-21
PYTHON_IMAGE=python:3.12.15-slim
# uv binary copied into the agent-service image
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.23
NODE_IMAGE=node:20.20.2-alpine
NGINX_IMAGE=nginx:1.31.7

# Infrastructure
KAFKA_IMAGE=apache/kafka:4.1.2
POSTGRES_IMAGE=postgres:16.15
REDIS_IMAGE=redis:8.10.2
OBJECT_STORE_IMAGE=chrislusf/seaweedfs:4.48

# Observability
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0
GRAFANA_IMAGE=grafana/grafana:13.2.4
TEMPO_IMAGE=grafana/tempo:3.0.4
LOKI_IMAGE=grafana/loki:3.6.18

# Local Kubernetes
K3S_IMAGE=rancher/k3s:v1.35.9-k3s1
# KEDA Helm chart (kedacore/keda), installed by deploy/k3d/up.sh.
KEDA_CHART_VERSION=2.21.0
# Image registry that k3d creates next to the cluster (deploy/k3d/cluster.yaml).
REGISTRY_IMAGE=registry:2.8.3

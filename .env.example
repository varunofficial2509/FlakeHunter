# api-gateway login, for running the gateway outside the cluster (services/api-gateway).
# Spring does not read this file: export these in the shell that runs the gateway.
# The gateway refuses to start without the password and the secret. Never commit a filled-in copy.
FLAKEHUNTER_ADMIN_USER=admin
FLAKEHUNTER_ADMIN_PASSWORD=
# At least 32 characters, e.g. from: openssl rand -base64 48
FLAKEHUNTER_JWT_SECRET=

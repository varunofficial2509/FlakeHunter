# Copy this file to .env and fill in real values: cp .env.example .env
# Never commit .env — only this template belongs in git.

# --- App ---
APP_ENV=development
LOG_LEVEL=info
PORT=8000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/flakehunter

# --- GitHub (for reading CI runs / test results) ---
GITHUB_TOKEN=

# --- Jira (for filing flaky-test issues) ---
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=FH
